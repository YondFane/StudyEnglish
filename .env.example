# Local Ollama is the default and does not require an API key.
EXAMPLE_AI_PROVIDER=ollama
EXAMPLE_AI_MODEL=qwen3:8b
EXAMPLE_AI_CONCURRENCY=2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=15m
EXAMPLE_AI_REVIEW=true
OLLAMA_THINK_FOR_UNDEFINED=false

# Optional OpenAI fallback. Never commit a real API key.
# EXAMPLE_AI_PROVIDER=openai
# EXAMPLE_AI_MODEL=gpt-5.4-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
